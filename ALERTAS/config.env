# ─────────────────────────────────────────────────────────────────────────────
# config.env — Configuración del sistema de alertas Eficacia
# ─────────────────────────────────────────────────────────────────────────────
# INSTRUCCIONES:
#   1. Rellena los valores marcados con <COMPLETAR>
#   2. NO compartas este archivo ni lo subas a repositorios (contiene el token)
#   3. Guarda el archivo con el nombre exacto: config.env (sin extensión .txt)
# ─────────────────────────────────────────────────────────────────────────────

# TOKEN DEL BOT DE TELEGRAM
# Obténlo de @BotFather en Telegram → /newbot → copia el token aquí.
# IMPORTANTE: el valor va SIN < > ni comillas. Formato: TELEGRAM_TOKEN=NN:AA...
# Si crees que el token fue expuesto, revócalo con /revoke en BotFather.
TELEGRAM_TOKEN=8748296914:AAEsqmC2JlVK3NTJZkwCf6Ity3o36a9pfhA

# UMBRALES DE SEMÁFORO (opcional — estos son los valores por defecto)
# ✅ Verde  → cumplimiento >= UMBRAL_OK
# ⚠️ Amarillo → cumplimiento entre UMBRAL_WARNING y UMBRAL_OK
# ❌ Rojo   → cumplimiento < UMBRAL_WARNING
UMBRAL_OK=0.90
UMBRAL_WARNING=0.70

CORREO_REMITENTE=giovanny_restrepo@eficacia.com.co